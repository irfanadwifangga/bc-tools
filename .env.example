# Salin ke .env lalu isi. JANGAN commit .env.

# --- Business Central (sandbox demo company saja) ---
BC_TENANT_ID=
BC_CLIENT_ID=
BC_CLIENT_SECRET=
# Nama environment BC, contoh: Sandbox
BC_ENVIRONMENT=
# Opsional: ID company default (GUID). Kosongkan untuk memilih dari companies.list()
BC_COMPANY_ID=
# Opsional: rute custom API lokal dengan format publisher/group/version
# BC_CUSTOM_API_ROUTE=

# --- Backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO
# Hanya dipakai jika/ketika DB dibutuhkan (lihat ADR-002)
DATABASE_URL=sqlite:///./data/bc_tools.db

# --- Frontend (origin yang diizinkan CORS) ---
FRONTEND_ORIGIN=http://localhost:5173

